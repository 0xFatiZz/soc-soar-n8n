    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { prompt, ...alert } = $('Build Prompt').item.json;\n\nlet ai = {};\nlet parseOk = true;\ntry {\n  ai = JSON.parse($json.response);\n} catch (e) {\n  ai = {};\n  parseOk = false;\n}\n\nconst base = Number(alert.base_score) || 0;\nconst inGray = base >= 30 && base <= 79;\n\nlet adjustment = Math.round(Number(ai.adjustment));\nif (!Number.isFinite(adjustment)) adjustment = 0;\nadjustment = Math.max(-10, Math.min(10, adjustment));\n\nlet score = base;\nlet applied = false;\nif (inGray) {\n  score = Math.max(0, Math.min(79, base + adjustment));\n  applied = adjustment !== 0;\n}\n\nconst severity = score < 20 ? 'low' : score < 50 ? 'medium' : score < 80 ? 'high' : 'critical';\nconst isThreat = score >= 50;\n\nlet action = 'ignore';\nif (score >= 80 && !alert.is_protected) action = 'block';\nelse if (score >= 50) action = 'investigate';\n\nlet summary = String(ai.summary || '').trim();\nif (!parseOk || !summary) summary = 'AI summary unavailable, decision based on scoring rules only.';\nconst parts = summary.split(/(?<=[.!?])\\s+/);\nif (parts.length > 2) summary = parts.slice(0, 2).join(' ');\n\nconst aiNote = inGray\n  ? `AI adjustment ${adjustment} ${applied ? 'applied' : 'neutral'}`\n  : `AI adjustment ${adjustment} ignored (outside gray zone)`;\nconst notes = `base ${base}: ${alert.score_reasons}; ${aiNote}; final ${score}${parseOk ? '' : '; AI response invalid'}`;\n\nreturn {\n  json: {\n    ...alert,\n    ai_parse_ok: parseOk,\n    base_score: base,\n    ai_adjustment: adjustment,\n    adjustment_applied: applied,\n    score,\n    severity,\n    is_threat: isThreat,\n    summary,\n    recommended_action: action,\n    guardrail_notes: notes\n  }\n};"
      },
