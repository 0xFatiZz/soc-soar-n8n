    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const PROTECTED_IPS = [\n  '192.168.10.10',\n  '192.168.20.10',\n  '192.168.30.10',\n  '192.168.35.10',\n  '192.168.40.10',\n  '192.168.154.10',\n  '10.0.7.15',\n  '192.168.10.1',\n  '192.168.20.1',\n  '192.168.30.1',\n  '192.168.35.1',\n  '192.168.40.1',\n  '192.168.154.1',\n  '192.168.154.254'\n];\n\nconst alert = $json;\nconst ip = String(alert.source_ip || '').trim();\n\nconst ipv4 = /^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$/;\n\nlet valid = true;\nlet reason = '';\n\nif (!ipv4.test(ip)) {\n  valid = false;\n  reason = 'invalid IPv4 format';\n} else {\n  const first = Number(ip.split('.')[0]);\n  if (first === 0 || first === 127 || first >= 224) {\n    valid = false;\n    reason = 'reserved or non-routable address';\n  } else if (PROTECTED_IPS.includes(ip) || alert.is_protected) {\n    valid = false;\n    reason = 'protected asset';\n  }\n}\n\nreturn {\n  json: {\n    ...alert,\n    block_valid: valid,\n    block_reject_reason: reason,\n    block_command: valid ? `pfctl -t n8n_blocklist -T add ${ip}` : ''\n  }\n};"
